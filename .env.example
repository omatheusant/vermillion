# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (Project Settings → API). Nunca comite .env.local — já está no
# .gitignore. Se o projeto foi provisionado via Vercel Marketplace
# (`vercel integration add supabase`), rode `vercel env pull .env.local`
# em vez de preencher isto à mão.

# --- Necessárias para rodar a aplicação (client + server) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Opcionais ---
# URL absoluta usada em links de email quando não há request ativa
# (fallback; em produção a app já detecta o host via headers).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Feature flag do login via Discord (ADR 0009) — desligado por padrão.
AUTH_DISCORD_ENABLED=false

# --- Necessárias só para scripts/ e testes E2E, nunca no client ---
# Chave service-role (bypassa RLS) — usada por scripts/seed-demo-data.mjs
# e pelos helpers de e2e/ para criar/remover usuários de teste via Admin API.
SUPABASE_SERVICE_ROLE_KEY=
# Connection string direta (não via pgbouncer) — usada por
# scripts/gen-db-types.mjs e pelo Supabase CLI (`supabase db push`).
POSTGRES_URL_NON_POOLING=
